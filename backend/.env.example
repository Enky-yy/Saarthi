# Fully keyless build: no external AI APIs. Optional local engines below.
# Local generator (Phase 4): small instruct model on your own GPU/CPU.
# Default downloads on first use (~3GB one time). Leave blank to disable.
LOCAL_GEN_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# MuRIL classifier dir (Phase 4 fine-tune output). Absent => rule-based.
MURIL_MODEL_DIR=models/muril-clf
# Gnani Prisma STT (voice notes): key from https://www.gnani.ai — get
# "X-API-Key-ID" from the Gnani console; without it, local whisper is used
GNANI_API_KEY=
