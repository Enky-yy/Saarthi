# Copy to .env (never commit real keys). App works fully without any of these.
# Gemini (free key in 2 min: https://aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Bhashini / ULCA (register at https://bhashini.gov.in, request API access;
# approval may take time — TTS/translation stay optional until keys land)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Gnani Prisma STT (voice notes): key from https://www.gnani.ai — get
# "X-API-Key-ID" from the Gnani console; without it, local whisper is used
GNANI_API_KEY=
